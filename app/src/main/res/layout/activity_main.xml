<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/descargar"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:fontFamily="serif"
        android:text="@string/daily_motivation"
        android:textAlignment="center"
        android:textColor="#503434"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtFrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:padding="20dp"
        android:text="@string/tv_Frase"
        android:textAlignment="center"
        android:textColor="#75543E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="353dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNuevaFrase"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#A67C52"
            android:text="@string/btn_Nueva_Frase"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnFavorito"
            style="@style/Widget.Material3.Button"
            android:layout_width="73dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="25dp"
            android:backgroundTint="#A67C52"
            android:minWidth="0dp"
            android:text="@string/btn_Favorito"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnVerFavoritos"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#503434"
        android:text="@string/btn_see_favoritos"
        android:textColor="#FFFFFF" />

</LinearLayout>
